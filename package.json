{
  "name": "gamerfy-music-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Bot de música do Gamerfy: /play <busca> toca do YouTube na sala de voz de quem pediu.",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src",
    "test": "vitest --run"
  },
  "dependencies": {
    "@gamerfy/bot": "^0.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@types/node": "^22.7.5",
    "eslint": "^9.13.0",
    "tsx": "^4.23.13",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.10.0",
    "vitest": "^3.2.4"
  }
}
